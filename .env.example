# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=300
MAX_OLLAMA_PASSES=3
# Modell fuer grosse Quelltexte (ab LARGE_TEXT_THRESHOLD Zeichen).
# Identisch zu OLLAMA_MODEL setzen, um den Wechsel abzuschalten.
OLLAMA_MODEL_SMALL=qwen2.5:14b
LARGE_TEXT_THRESHOLD=15000
# Gesamtes Kontextfenster (Prompt + Ausgabe) fuer Paesse mit vollem Quelltext.
# Muss den kompletten OCR-Text aufnehmen koennen, sonst wird er beschnitten.
OLLAMA_NUM_CTX_LARGE=16384
OLLAMA_NUM_CTX=8192

# Directories (Docker-Pfade)
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
FORM_TEMPLATE_DIR=/app/data

# Upload-Limits
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=10

# OCR
OCR_LANGUAGE=deu
